{
  "mcpServers": {
    "gong": {
      "type": "http",
      "url": "https://mcp.gong.io/mcp",
      "oauth": { "callbackPort": 8765 }
    },
    "fathom": {
      "type": "http",
      "url": "https://api.fathom.ai/mcp"
    },
    "google-workspace": {
      "command": "uvx",
      "args": ["workspace-mcp@2.1.0", "--tools", "drive", "docs", "sheets", "slides", "--tool-tier", "extended"],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${user_config.google_oauth_client_id}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${user_config.google_oauth_client_secret}",
        "USER_GOOGLE_EMAIL": "${user_config.google_email}",
        "OAUTHLIB_INSECURE_TRANSPORT": "1"
      }
    }
  }
}
